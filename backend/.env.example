ENVIRONMENT=development
DEBUG=true

SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lwkapply
TEST_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lwkapply_test
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=lwkapply-documents

# Cloudflare dashboard > R2 > Overview for the account ID; Manage R2 API
# Tokens to create a token scoped to R2_BUCKET only (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lwkapply-documents

# app/services/email_smtp.py - only used by the Celery-based reference
# reminders pipeline (app/tasks/reminders_celery.py) and local dev
# (MailHog). Production (reminders_inline.py) uses the Gmail API
# settings below instead - see that module's own comment for why.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
FRONTEND_URL=
RESEND_API_KEY=

# app/services/email_gmail_api.py - what reminders_inline.py (the
# production path) actually sends through. GMAIL_API_REFRESH_TOKEN is
# minted once, locally, via scripts/gmail_oauth_setup.py. Leave blank to
# leave this backend disabled (send_email() logs an error and returns
# False, same "unconfigured feature fails clearly" precedent as
# GEMINI_API_KEY below).
GMAIL_API_CLIENT_ID=
GMAIL_API_CLIENT_SECRET=
GMAIL_API_REFRESH_TOKEN=
GMAIL_API_SENDER_EMAIL=

# AI features (Resume Parser + ATS Score) - Google AI Studio API key.
# Leave blank to leave these features disabled (endpoints return 503).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Shared daily cap on resume-analyses + ats-scores per user (free tier -
# no premium tier exists yet, so this applies to everyone for now).
AI_FREE_TIER_DAILY_LIMIT=10

# Shared secret an external scheduler presents (X-Internal-Cron-Secret
# header) to POST /api/v1/internal/reminders/run - see
# app/api/v1/endpoints/internal.py and .github/workflows/reminders-cron.yml.
# Leave blank to disable that endpoint entirely (returns 503).
INTERNAL_CRON_SECRET=
