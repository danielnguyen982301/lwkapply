{
  "manifest_version": 3,
  "name": "LwkApply Quick Capture",
  "version": "0.1.0",
  "description": "Save a job posting to your LwkApply tracker without retyping it.",
  "permissions": ["storage", "activeTab", "webRequest"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.vietnamworks.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.vietnamworks.com/*"],
      "js": ["src/content/vietnamworks.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Save to LwkApply"
  }
}
