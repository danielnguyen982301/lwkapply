{
  "manifest_version": 3,
  "name": "LwkApply Quick Capture",
  "version": "1.0.0",
  "description": "Automatically syncs your VietnamWorks saves and applications into LwkApply, and lets you capture any job posting manually.",
  "browser_specific_settings": {
    "gecko": {
      "id": "quick-capture@lwkapply.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo", "websiteContent", "websiteActivity"]
      }
    }
  },
  "permissions": ["storage", "webRequest"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://lwkapply-api.onrender.com/*",
    "https://*.vietnamworks.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "scripts": ["src/background/background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.vietnamworks.com/*"],
      "js": ["src/content/vietnamworks.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Save to LwkApply",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
